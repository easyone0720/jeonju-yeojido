# ---- AI: 이야기·전생 유형 분류 = Claude (Anthropic Messages API, https://api.anthropic.com/v1/messages) ----
# ANTHROPIC_API_KEY: https://console.anthropic.com/settings/keys 에서 발급.
# 서버(server.ts, Vercel 함수 api/past-life/story.ts)에서만 읽으며 브라우저로 노출되지 않습니다.
# 절대 VITE_ 접두사를 붙이지 마세요(번들에 포함됩니다). 비워 두거나 예시값 그대로면
# 기본 샘플 스토리 + 브라우저 캔버스 전통 초상화로 자동 폴백합니다 (로컬 데모 모드).
ANTHROPIC_API_KEY=MY_ANTHROPIC_API_KEY

# (선택) 사용할 Claude 모델. 비우면 기본값 claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- 초상화·낭독 음성: 결제·API 키 없이 동작 ----
# 낭독 음성은 msedge-tts(Edge 신경망 한국어 음성)를 쓰며 설정이 필요 없습니다. (bun add msedge-tts)
# 초상화는 GEMINI_API_KEY(무료 티어)로 gemini-2.5-flash-image 를 먼저 호출하고, 429·오류로 실패하면 Pollinations.ai(키 불필요)를 1회 호출,
# 그것도 실패하면 같은 유형의 기존 캐릭터 초상화(public/characters)로 대체합니다. (서버 전용 — VITE_ 금지)

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_NAVER_MAP_CLIENT_ID (or NAVER_MAP_CLIENT_ID):
# Naver Cloud Platform Maps Application Client ID (Dynamic Map - Web Dynamic Map).
# Only Client ID is passed to browser JS SDK (oapi.map.naver.com). Never expose Client Secret in browser.
VITE_NAVER_MAP_CLIENT_ID=""
NAVER_MAP_CLIENT_ID=""

# VITE_GOOGLE_CLIENT_ID: Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 만든
# 'OAuth 2.0 웹 클라이언트 ID'. 승인된 JavaScript 원본에 개발/배포 주소(예: http://localhost:3000)를 추가해야 합니다.
# 비워 두면 Google 버튼은 'Google 체험자' 계정으로 안전하게 폴백합니다.
VITE_GOOGLE_CLIENT_ID=""

# 전생 결과 생성 모드 (mock | api). 비우면 mock. 실행 중에는 URL ?mock=1 로 Mock 강제 전환
VITE_PAST_LIFE_MODE=mock

# ---- 맞춤형 전생 (VITE_PAST_LIFE_MODE=api 일 때 사용) ----
# 브라우저용 (빌드에 포함됨 — 공개 가능한 값만): Supabase 프로젝트 URL(https://<프로젝트>.supabase.co)과 Publishable 키
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
# 서버 전용 (Vercel 환경변수에만 설정. 절대 VITE_ 접두사를 붙이지 말 것)
SUPABASE_SECRET_KEY=""
