# GEMINI_API_KEY: Gemini API 키 (https://aistudio.google.com/apikey 에서 발급).
# 서버(server.ts)에서만 읽으며 브라우저로 노출되지 않습니다. 비워 두거나 아래 예시값 그대로면
# 기본 샘플 스토리 + 브라우저 캔버스 전통 초상화로 자동 폴백합니다.
# AI Studio에서 실행하면 Secrets 패널에서 자동 주입됩니다.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# (선택) 사용할 모델 이름. 비우면 기본값을 사용합니다.
# GEMINI_TEXT_MODEL: 전생 스토리 생성 (Structured Output JSON). 기본값 gemini-2.5-flash
# GEMINI_IMAGE_MODEL: 전생 캐릭터 일러스트 생성 (이미지 입력 지원 모델 필요). 기본값 gemini-2.5-flash-image
GEMINI_TEXT_MODEL="gemini-2.5-flash"
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_NAVER_MAP_CLIENT_ID (or NAVER_MAP_CLIENT_ID):
# Naver Cloud Platform Maps Application Client ID (Dynamic Map - Web Dynamic Map).
# Only Client ID is passed to browser JS SDK (oapi.map.naver.com). Never expose Client Secret in browser.
VITE_NAVER_MAP_CLIENT_ID=""
NAVER_MAP_CLIENT_ID=""

